# 小米 MiMo 语音克隆 WebUI 环境变量配置
# 复制此文件为 .env 并填入实际值

# 管理员账号（留空则不启用管理后台）
ADMIN_USER=admin
ADMIN_PASS=your-password-here

# Google Analytics 4 衡量 ID（留空则不启用）
GA_ID=G-XXXXXXXXXX

# 密钥（用于 session 加密，随机生成即可）
SECRET_KEY=change-me-to-a-random-string

# 资源限制
MAX_FILES=5              # 最大上传文件数
MAX_FILE_SIZE_MB=5       # 单文件最大 MB
MAX_TOTAL_SIZE_MB=10     # 合并后最大 MB
RATE_LIMIT=10            # 每分钟最大请求数

# 服务端口
PORT=7860
